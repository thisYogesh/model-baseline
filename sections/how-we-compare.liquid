      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "competitor",
      "name": "Competitor",
      "settings": [
        {
          "type": "header",
          "content": "Brand"
        },
        {
          "type": "text",
          "id": "logo_asset",
          "label": "Logo SVG asset"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "text",
          "id": "format_text",
          "label": "Format"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "Highlight column",
          "default": false
        },
        {
          "type": "range",
          "id": "logo_opacity",
          "label": "Logo opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 100
        },
        {
          "type": "header",
          "content": "Features"
        },
        {
          "type": "checkbox",
          "id": "feature_1",
          "label": "Feature 1",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "feature_2",
