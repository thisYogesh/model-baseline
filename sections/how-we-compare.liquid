{%- liquid
  assign heading = section.settings.heading
  assign format_label = section.settings.format_label
  assign footnote = section.settings.footnote
  assign bg_color = section.settings.background_color
-%}

<div
  class="how-we-compare spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if bg_color != blank %}background-color: {{ bg_color }};{% endif %}
  "
>
  <div class="page-width">
    {%- if heading != blank -%}
      <h2 class="how-we-compare__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="how-we-compare__table-wrapper">
      <table class="how-we-compare__table" role="table">
        <thead>
          <tr>
            <th class="how-we-compare__corner-cell"></th>
            {%- for block in section.blocks -%}
              <th
                class="how-we-compare__brand-header{% if block.settings.is_highlighted %} how-we-compare__brand-header--highlighted{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.logo_asset != blank -%}
                  <img
                    src="{{ block.settings.logo_asset | asset_url }}"
                    alt="{{ block.settings.brand_name }}"
                    class="how-we-compare__logo"
                    loading="lazy"
                    {% if block.settings.logo_opacity != blank and block.settings.logo_opacity < 100 %}
                      style="opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};"
                    {% endif %}
                  >
                {%- elsif block.settings.logo != blank -%}
                  {%- assign logo_opacity_val = block.settings.logo_opacity | divided_by: 100.0 -%}
                  {%- assign logo_style = '' -%}
                  {%- if block.settings.logo_opacity != blank and block.settings.logo_opacity < 100 -%}
                    {%- capture logo_style -%}opacity: {{ logo_opacity_val }};{%- endcapture -%}
                  {%- endif -%}
                  {{
                    block.settings.logo
                    | image_url: width: 200
                    | image_tag:
                      alt: block.settings.brand_name,
                      class: 'how-we-compare__logo',
                      loading: 'lazy',
                      style: logo_style
                  }}
                {%- else -%}
                  <span class="how-we-compare__brand-name-text">{{ block.settings.brand_name }}</span>
                {%- endif -%}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- if format_label != blank -%}
            <tr class="how-we-compare__row">
              <td class="how-we-compare__feature-label">{{ format_label }}</td>
              {%- for block in section.blocks -%}
                <td class="how-we-compare__cell{% if block.settings.is_highlighted %} how-we-compare__cell--highlighted{% endif %}">
                  <span class="how-we-compare__format-value">{{ block.settings.format_text }}</span>
                </td>
              {%- endfor -%}
            </tr>
          {%- endif -%}

          {%- for feature_num in (1..7) -%}
            {%- capture feature_label_key -%}feature_{{ feature_num }}_label{%- endcapture -%}
            {%- assign feature_label = section.settings[feature_label_key] -%}
            {%- if feature_label != blank -%}
              <tr class="how-we-compare__row">
                <td class="how-we-compare__feature-label">{{ feature_label }}</td>
                {%- for block in section.blocks -%}
                  {%- capture feature_key -%}feature_{{ feature_num }}{%- endcapture -%}
                  {%- assign feature_val = block.settings[feature_key] -%}
                  <td class="how-we-compare__cell{% if block.settings.is_highlighted %} how-we-compare__cell--highlighted{% endif %}">
                    {%- if feature_val -%}
                      <svg class="how-we-compare__check" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Yes">
                        <path d="M16.5 5.5L8 14L3.5 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- else -%}
                      <span class="how-we-compare__dash" aria-label="No">&mdash;</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if footnote != blank -%}
      <p class="how-we-compare__footnote">{{ footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .how-we-compare {
    width: 100%;
  }

  .how-we-compare__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    text-align: center;
    margin: 0 0 40px;
    font-size: 32px;
    line-height: 1.2;
  }

  .how-we-compare__table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .how-we-compare__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  .how-we-compare__corner-cell {
    width: 200px;
    min-width: 160px;
  }

  .how-we-compare__brand-header {
    text-align: center;
    padding: 16px 8px;
    vertical-align: bottom;
    min-width: 100px;
  }

  .how-we-compare__brand-header--highlighted {
    background-color: rgba(0, 0, 0, 0.04);
    border-radius: 8px 8px 0 0;
  }

  .how-we-compare__logo {
    max-width: 100px;
    max-height: 40px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .how-we-compare__brand-name-text {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
  }

  .how-we-compare__row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .how-we-compare__feature-label {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.4;
    padding: 14px 16px 14px 0;
    vertical-align: middle;
    color: rgb(var(--color-foreground));
  }

  .how-we-compare__cell {
    text-align: center;
    padding: 14px 8px;
    vertical-align: middle;
  }

  .how-we-compare__cell--highlighted {
    background-color: rgba(0, 0, 0, 0.04);
  }

  .how-we-compare__check {
    color: #14495B;
    width: 20px;
    height: 20px;
  }

  .how-we-compare__dash {
    color: rgba(0, 0, 0, 0.25);
    font-size: 18px;
  }

  .how-we-compare__format-value {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.3;
    color: rgb(var(--color-foreground));
  }

  .how-we-compare__footnote {
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.5);
    margin: 24px 0 0;
  }

  @media screen and (min-width: 750px) {
    .how-we-compare__heading {
      font-size: 40px;
      margin-bottom: 48px;
    }

    .how-we-compare__corner-cell {
      width: 240px;
    }
  }
{% endstylesheet %}

