{% liquid
  assign addon_product = block.settings.product
  assign addon_variant = addon_product.selected_or_first_available_variant
%}

{% if addon_product != blank %}
  <div class="product-addon" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <p class="product-addon__heading">{{ block.settings.heading }}</p>
    {% endif %}

    <div class="product-addon__card">
      <div class="product-addon__content">
        {% if addon_product.featured_image != blank %}
          <a href="{{ addon_product.url }}" class="product-addon__image-link">
            {{
              addon_product.featured_image
              | image_url: width: 320
              | image_tag:
                widths: '160,320',
                sizes: '80px',
                loading: 'lazy',
                class: 'product-addon__image',
                alt: addon_product.title
            }}
          </a>
        {% endif %}

        <div class="product-addon__info">
          <p class="product-addon__title">{{ addon_product.title }}</p>
          {% unless addon_product.has_only_default_variant %}
            <div class="product-addon__meta">
              {% for option in addon_product.options_with_values %}
                <span class="product-addon__option">
                  {% if option.selected_value.swatch.color %}
                    <span
                      class="product-addon__chip"
                      style="background-color: {{ option.selected_value.swatch.color }};"
                    ></span>
                  {% endif %}
                  {{ option.selected_value }}
                </span>
              {% endfor %}
            </div>
          {% endunless %}
        </div>
      </div>

      {% form 'product', addon_product, class: 'product-addon__form' %}
        <input type="hidden" name="id" value="{{ addon_variant.id }}">
        <button
          type="submit"
          class="product-addon__button"
          {% unless addon_variant.available %}
            disabled
          {% endunless %}
        >
          {%- if addon_variant.available -%}
            {{ block.settings.button_prefix }}&nbsp;&nbsp;|&nbsp;&nbsp;{{ addon_variant.price | money }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      {% endform %}
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="product-addon product-addon--empty" {{ block.shopify_attributes }}>
    <p class="product-addon__heading">Select a product in the block settings to display the add-on card.</p>
  </div>
{% endif %}

{% stylesheet %}
  .product-addon {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-addon__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.14px;
  }

  .product-addon__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    background-color: #ffffff;
    border: 1px solid #231f20;
  }

  .product-addon__content {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-inline: 6px;
    min-width: 0;
  }

  .product-addon__image-link {
    flex-shrink: 0;
    display: block;
    width: 80px;
  }

  .product-addon__image {
    display: block;
    width: 80px;
    height: auto;
  }

  .product-addon__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    min-width: 0;
  }

  .product-addon__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 20px;
  }

  .product-addon__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.14px;
  }

  .product-addon__option {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .product-addon__chip {
    display: inline-block;
    width: 13px;
    height: 13px;
    border-radius: 2px;
    border: 1px solid #231f20;
  }

  .product-addon__form {
    margin: 0;
  }

  .product-addon__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 24px;
    background-color: transparent;
    border: 1px solid #14495b;
    border-radius: 0;
    color: #14495b;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 600;
    line-height: 16px;
    cursor: pointer;
  }

  .product-addon__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (min-width: 750px) {
    .product-addon__card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 16px 32px 16px 16px;
    }

    .product-addon__image-link,
    .product-addon__image {
      width: 75px;
    }

    .product-addon__button {
      width: auto;
      flex-shrink: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product add-on",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Add-on"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Add-on product"
    },
    {
      "type": "text",
      "id": "button_prefix",
      "label": "Button label",
      "default": "Add to Cart"
    }
  ]
}
{% endschema %}
