<div class="clean-ingredients-bar spacing-style" {{ block.shopify_attributes }}
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% if block.settings.background_color != blank %}--clean-ingredients-bar-bg: {{ block.settings.background_color }};{% endif %}
  "
>
  {%- if block.settings.heading != blank -%}
    <h2 class="clean-ingredients-bar__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  <div class="clean-ingredients-bar__content">
    <div class="clean-ingredients-bar__rows">
      {%- for i in (1..4) -%}
        {%- liquid
          case i
            when 1
              assign row_label = block.settings.row_1_label
              assign row_desc = block.settings.row_1_description
            when 2
              assign row_label = block.settings.row_2_label
              assign row_desc = block.settings.row_2_description
            when 3
              assign row_label = block.settings.row_3_label
              assign row_desc = block.settings.row_3_description
            when 4
              assign row_label = block.settings.row_4_label
              assign row_desc = block.settings.row_4_description
          endcase
        -%}
        {%- if row_label != blank -%}
          <div class="clean-ingredients-bar__row">
            <div class="clean-ingredients-bar__row-label">{{ row_label }}</div>
            {%- if row_desc != blank -%}
              <div class="clean-ingredients-bar__row-description">{{ row_desc | newline_to_br }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="clean-ingredients-bar__badges">
      {%- if block.settings.badge_1_label != blank -%}
        <div class="clean-ingredients-bar__badge">
          {%- if block.settings.badge_1_image != blank -%}
            {{ block.settings.badge_1_image | image_url: width: 120 | image_tag: alt: block.settings.badge_1_label, loading: 'lazy', class: 'clean-ingredients-bar__badge-image' }}
          {%- endif -%}
          <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_1_label }}</span>
        </div>
      {%- endif -%}
      {%- if block.settings.badge_2_label != blank -%}
        <div class="clean-ingredients-bar__badge">
          {%- if block.settings.badge_2_image != blank -%}
            {{ block.settings.badge_2_image | image_url: width: 120 | image_tag: alt: block.settings.badge_2_label, loading: 'lazy', class: 'clean-ingredients-bar__badge-image' }}
          {%- endif -%}
          <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_2_label }}</span>
        </div>
      {%- endif -%}
      {%- if block.settings.badge_3_label != blank -%}
        <div class="clean-ingredients-bar__badge">
          {%- if block.settings.badge_3_image != blank -%}
            {{ block.settings.badge_3_image | image_url: width: 120 | image_tag: alt: block.settings.badge_3_label, loading: 'lazy', class: 'clean-ingredients-bar__badge-image' }}
          {%- endif -%}
          <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_3_label }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.cta_label != blank -%}
    <a class="clean-ingredients-bar__cta button-unstyled"
      {%- if block.settings.cta_link != blank %} href="{{ block.settings.cta_link }}"{% endif -%}
    >
      {{ block.settings.cta_label }}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .clean-ingredients-bar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    background-color: var(--clean-ingredients-bar-bg, transparent);
    border-radius: 8px;
    padding: 40px;
  }

  .clean-ingredients-bar__heading {
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .clean-ingredients-bar__content {
    display: flex;
    flex-direction: row;
    gap: 48px;
  }

  .clean-ingredients-bar__rows {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .clean-ingredients-bar__row {
    display: flex;
    flex-direction: row;
    gap: 24px;
    padding-block: 16px;
    border-block-end: 1px solid rgba(0, 0, 0, 0.15);
  }

  .clean-ingredients-bar__row:last-child {
    border-block-end: none;
  }

  .clean-ingredients-bar__row-label {
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    min-width: 140px;
    flex-shrink: 0;
  }

  .clean-ingredients-bar__row-description {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .clean-ingredients-bar__badges {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .clean-ingredients-bar__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    max-width: 80px;
  }

  .clean-ingredients-bar__badge-image {
    width: 60px;
    height: auto;
    object-fit: contain;
  }

  .clean-ingredients-bar__badge-label {
    font-family: var(--font-subheading--family);
    font-size: 0.625rem;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .clean-ingredients-bar__cta {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    text-decoration: underline;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .clean-ingredients-bar {
      padding: 24px 16px;
      gap: 24px;
    }

    .clean-ingredients-bar__heading {
      font-size: 1.75rem;
    }

    .clean-ingredients-bar__content {
      flex-direction: column;
      gap: 32px;
    }

    .clean-ingredients-bar__row {
      flex-direction: column;
      gap: 8px;
    }

    .clean-ingredients-bar__row-label {
      min-width: unset;
    }

    .clean-ingredients-bar__badges {
      justify-content: center;
    }
  }
{% endstylesheet %}

