{%- comment -%}
  Clean Ingredients Bar — renders ingredient information rows
  and certification badges inside a colored content card.
{%- endcomment -%}

<div class="clean-ingredients-bar" {{ block.shopify_attributes }} style="--cib-bg: {{ block.settings.background_color }};">
  {%- if block.settings.heading != blank -%}
    <h2 class="clean-ingredients-bar__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  <div class="clean-ingredients-bar__rows">
    {%- if block.settings.row_1_label != blank -%}
      <div class="clean-ingredients-bar__row">
        <p class="clean-ingredients-bar__row-label">{{ block.settings.row_1_label }}</p>
        {%- if block.settings.row_1_description != blank -%}
          <p class="clean-ingredients-bar__row-desc">{{ block.settings.row_1_description | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block.settings.row_2_label != blank -%}
      <div class="clean-ingredients-bar__row">
        <p class="clean-ingredients-bar__row-label">{{ block.settings.row_2_label }}</p>
        {%- if block.settings.row_2_description != blank -%}
          <p class="clean-ingredients-bar__row-desc">{{ block.settings.row_2_description | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block.settings.row_3_label != blank -%}
      <div class="clean-ingredients-bar__row">
        <p class="clean-ingredients-bar__row-label">{{ block.settings.row_3_label }}</p>
        {%- if block.settings.row_3_description != blank -%}
          <p class="clean-ingredients-bar__row-desc">{{ block.settings.row_3_description | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block.settings.row_4_label != blank -%}
      <div class="clean-ingredients-bar__row">
        <p class="clean-ingredients-bar__row-label">{{ block.settings.row_4_label }}</p>
        {%- if block.settings.row_4_description != blank -%}
          <p class="clean-ingredients-bar__row-desc">{{ block.settings.row_4_description | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    assign has_badges = false
    if block.settings.badge_1_label != blank
      assign has_badges = true
    endif
    if block.settings.badge_2_label != blank or block.settings.badge_2_image != blank
      assign has_badges = true
    endif
    if block.settings.badge_3_label != blank or block.settings.badge_3_image != blank
      assign has_badges = true
    endif
  -%}

  {%- if has_badges -%}
    <div class="clean-ingredients-bar__badges">
      {%- if block.settings.badge_1_label != blank -%}
        <div class="clean-ingredients-bar__badge">
          <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_1_label }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.badge_2_label != blank or block.settings.badge_2_image != blank -%}
        <div class="clean-ingredients-bar__badge">
          {%- if block.settings.badge_2_image != blank -%}
            {%- assign badge_2_alt = block.settings.badge_2_label | default: 'Certification badge' | escape -%}
            {{ block.settings.badge_2_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: badge_2_alt, class: 'clean-ingredients-bar__badge-img' }}
          {%- endif -%}
          {%- if block.settings.badge_2_label != blank -%}
            <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_2_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if block.settings.badge_3_label != blank or block.settings.badge_3_image != blank -%}
        <div class="clean-ingredients-bar__badge">
          {%- if block.settings.badge_3_image != blank -%}
            {%- assign badge_3_alt = block.settings.badge_3_label | default: 'Certification badge' | escape -%}
            {{ block.settings.badge_3_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: badge_3_alt, class: 'clean-ingredients-bar__badge-img' }}
          {%- endif -%}
          {%- if block.settings.badge_3_label != blank -%}
            <span class="clean-ingredients-bar__badge-label">{{ block.settings.badge_3_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.cta_label != blank -%}
    <p class="clean-ingredients-bar__cta">{{ block.settings.cta_label }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .clean-ingredients-bar {
    background-color: var(--cib-bg, #E9EA6B);
    border-radius: 12px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    color: #231F20;
  }

  .clean-ingredients-bar__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 28px;
    letter-spacing: -0.5px;
    line-height: 1.1;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .clean-ingredients-bar__heading {
      font-size: 36px;
    }
  }

  .clean-ingredients-bar__rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .clean-ingredients-bar__row {
    padding: 16px 0;
    border-bottom: 1px solid rgba(35, 31, 32, 0.15);
    text-align: start;
  }

  .clean-ingredients-bar__row:last-child {
    border-bottom: none;
  }

  .clean-ingredients-bar__row-label {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 4px;
  }

  .clean-ingredients-bar__row-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .clean-ingredients-bar__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    padding-block-start: 8px;
  }

  .clean-ingredients-bar__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .clean-ingredients-bar__badge-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .clean-ingredients-bar__badge-label {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }

  .clean-ingredients-bar__cta {
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    margin: 0;
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    .clean-ingredients-bar {
      padding: 48px 40px;
    }

    .clean-ingredients-bar__badge-img {
      width: 56px;
      height: 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Clean ingredients bar",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Formula"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#E9EA6B"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View all ingredients"
    },
    {
      "type": "header",
      "content": "Row 1"
    },
    {
      "type": "text",
      "id": "row_1_label",
      "label": "Label",
      "default": "Biobased"
    },
    {
      "type": "textarea",
      "id": "row_1_description",
      "label": "Description",
      "default": "USDA Certified Biobased with 58% derived from renewable resources."
    },
    {
      "type": "header",
      "content": "Row 2"
    },
    {
      "type": "text",
      "id": "row_2_label",
      "label": "Label",
      "default": "Pod Film"
    },
    {
      "type": "textarea",
      "id": "row_2_description",
      "label": "Description",
      "default": "Water-soluble PVOH that dissolves and biodegrades."
    },
    {
      "type": "header",
      "content": "Row 3"
    },
    {
      "type": "text",
      "id": "row_3_label",
      "label": "Label",
      "default": "Made With"
    },
    {
      "type": "textarea",
      "id": "row_3_description",
      "label": "Description",
      "default": "Five specialized enzymes and three surfactants, each with a dirty job."
    },
    {
      "type": "header",
      "content": "Row 4"
    },
    {
      "type": "text",
      "id": "row_4_label",
      "label": "Label",
      "default": "Never Made With"
    },
    {
      "type": "textarea",
      "id": "row_4_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Certification badges"
    },
    {
      "type": "text",
      "id": "badge_1_label",
      "label": "Badge 1 label",
      "default": "B Corp Certified"
    },
    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Badge 2 image"
    },
    {
      "type": "text",
      "id": "badge_2_label",
      "label": "Badge 2 label",
      "default": "Leaping Bunny"
    },
    {
      "type": "image_picker",
      "id": "badge_3_image",
      "label": "Badge 3 image"
    },
    {
      "type": "text",
      "id": "badge_3_label",
      "label": "Badge 3 label",
      "default": "EPA Safer Choice"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Clean ingredients bar"
    }
  ]
}
{% endschema %}
